# ==============================================================================
# SYNCNODE ENTERPRISE PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port & Binding
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 1. SECURITY & AUTHENTICATION (CRIT-001, CRIT-002, HIGH-005)
# ------------------------------------------------------------------------------
# Must be at least 32 characters long. In production, generate using:
# openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_random_at_least_32_chars_secret_string!

# Access token lifespan (e.g., '15m', '1h')
JWT_EXPIRES_IN=15m

# Comma-separated list of permitted CORS origins (Never use '*' in production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://novextrade.exchange

# ------------------------------------------------------------------------------
# 2. DATABASE & PERSISTENCE (Supabase Cloud PostgreSQL & MongoDB)
# ------------------------------------------------------------------------------
# Supabase Cloud Project Configuration (Recommended)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# MongoDB Connection URL (Optional Fallback)
MONGODB_URI=mongodb://localhost:27017/novextrade

# Optional Redis Cache / PubSub URL
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. RATE LIMITING (HIGH-008)
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=20

# ------------------------------------------------------------------------------
# 4. EXTERNAL MARKET DATA FEEDS
# ------------------------------------------------------------------------------
BINANCE_API_BASE_URL=https://api.binance.com
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ------------------------------------------------------------------------------
# 5. ADMIN CONSOLE BOOTSTRAP
# ------------------------------------------------------------------------------
# Required in production to create the initial SUPER_ADMIN account.
# In non-production environments, documented local development credentials are
# used automatically when these are not set.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=


# ------------------------------------------------------------------------------
# 6. PRODUCTION DOMAIN, REFERRALS & CARD PAYMENT GATEWAYS
# ------------------------------------------------------------------------------
# Public production application URL used to build user referral links & redirects
APP_BASE_URL=https://novextrade.exchange

# Active card payment gateway ('flutterwave' | 'paystack')
CARD_PAYMENT_PROVIDER=flutterwave

# Flutterwave v3 (Never expose secret keys to the frontend)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Paystack (Optional secondary card gateway)
PAYSTACK_SECRET_KEY=

# ------------------------------------------------------------------------------
# 7. GLOBAL CRYPTOCURRENCY WALLET & ON-CHAIN VERIFICATION RPCs
# ------------------------------------------------------------------------------
# Initial default global receiving wallet (can be updated anytime in Admin Console)
GLOBAL_CRYPTO_RECEIVING_ADDRESS=0x71C8366420A092679b5436194448873305370caD
GLOBAL_CRYPTO_NETWORK=ERC20
GLOBAL_CRYPTO_ASSET=USDT
GLOBAL_CRYPTO_CONFIRMATIONS=12
GLOBAL_CRYPTO_MEMO_TAG=

# Blockchain RPC / Explorer Endpoints for Server-Side Verification
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BSC_RPC_URL=https://bsc-dataseed.binance.org
TRONGRID_API_URL=https://api.trongrid.io
TRONGRID_API_KEY=
BTC_EXPLORER_API_URL=https://blockstream.info/api
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
